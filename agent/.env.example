# 複製成 .env 後再修改：cp .env.example .env
# .env 不可 commit（已列在 .gitignore）

# Ollama 服務位址（只應指向本機）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Agent 服務埠
PORT=8787

# 允許呼叫 Agent 的網頁來源，逗號分隔；不可使用 *
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://ash-eeee.github.io

# 景點資料（相對於 agent/ 資料夾，或絕對路徑）；唯讀
LOCATIONS_PATH=../data/locations.json

# 開發時設為 1 才會開啟 /docs API 文件頁面
DEBUG=0
